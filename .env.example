# SMS Gateway Settings (Semaphore PH, Twilio, or log for testing)
# SMS & Notification Settings:
# Options: 'semaphore', 'httpsms' (Free Android SIM gateway), 'smtp' (Free Gmail), 'twilio', 'log'
SMS_PROVIDER=log

# 1. Semaphore (Free trial credits on sign up at https://semaphore.co - PH Telcos: Globe, Smart, DITO)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# 2. httpSMS (100% Free Android Gateway - uses your phone's SIM unli text via https://httpsms.com)
HTTPSMS_API_KEY=
HTTPSMS_FROM_PHONE=

# 3. SMTP / Email-to-SMS Gateway (Free via Gmail SMTP)
SMS_EMAIL_GATEWAY=
SMS_SMTP_FALLBACK_EMAIL=

# 4. Twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# Google OAuth web client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
